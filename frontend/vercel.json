{
  "buildCommand": "node scripts/generate-india-geojson.mjs && tsc -b && vite build",
  "functions": { "api/maps.js": { "maxDuration": 60 } },
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), browsing-topics=()"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/assets/.*", "status": 404, "headers": { "Cache-Control": "no-store" } },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
