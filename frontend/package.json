{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-india-geojson.mjs",
    "dev": "vite",
    "build": "node scripts/generate-india-geojson.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "d3-geo": "^3.1.1",
    "firebase": "^12.18.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/osmtogeojson": "^2.2.34",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vercel": "^59.11.7",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
