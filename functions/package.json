{
  "name": "functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../scripts/sync-contracts.mjs && tsc",
    "gcp-build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "demo:whatsapp": "node scripts/demo-whatsapp-test.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:purge": "node scripts/seed-demo.js --purge",
    "test": "npm run build && node --test tests/*.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-forestwatch \"node --test --test-concurrency=1 tests/test-firestore-rules.mjs tests/test-transactions.mjs\"",
    "test:all": "npm run test && npm run test:rules"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "1.3.6",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vladmandic/face-api": "1.7.15",
    "asn1js": "3.0.10",
    "exifr": "7.1.3",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "pdfjs-dist": "6.3.289",
    "pkijs": "3.4.1",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.2",
    "firebase": "^12.18.0",
    "qrcode": "1.5.4",
    "typescript": "^5.6.3"
  }
}
