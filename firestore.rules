rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Any staff account (viewer, officer or admin) with an entry in the
    // `officers` allow-list and a sign-in under eight hours old. That
    // collection is Admin-SDK-only (see below), so this cannot be
    // self-granted from a client.
    function isOfficer() {
      return request.auth != null
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time > 0
        && timestamp.value(request.auth.token.auth_time * 1000) <= request.time + duration.value(60, 's')
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(8, 'h')
        && exists(/databases/$(database)/documents/officers/$(request.auth.uid));
    }

    // Raw case data (names, phone numbers, narratives, coordinates, ID
    // documents) is for officers and administrators. A missing `access` field
    // is an account allow-listed before access levels existed, all full
    // officers; "viewer", null or any unknown value reads nothing raw and sees
    // cases only through the masked callables (getMaskedCase, listTickets).
    // Mirrors normalizeAccess in functions/src/features/tickets/access.ts.
    function canReadCases() {
      return isOfficer()
        && get(/databases/$(database)/documents/officers/$(request.auth.uid)).data.get("access", "officer") in ["officer", "admin"];
    }

    // Allow-list of officer accounts. Only the Admin SDK (Cloud
    // Functions / console, which bypasses rules) may create or modify
    // entries — a client can never grant itself officer access by writing
    // its own doc here.
    match /officers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Collection reads must be paged (the portal asks for 50 at a time), so one
    // session cannot pull a whole case history or registry in a single query.
    function isPagedQuery() {
      return request.query.limit is int && request.query.limit <= 100;
    }

    match /tickets/{ticketId}/notes/{noteId} {
      allow get: if canReadCases();
      allow list: if canReadCases() && isPagedQuery();
      allow write: if false;
    }
    match /tickets/{ticketId}/events/{eventId} {
      allow get: if canReadCases();
      allow list: if canReadCases() && isPagedQuery();
      allow write: if false;
    }

    // A dispute ticket is not public data. The document holds the reporter's
    // name and phone number, the named opposing party, a free-text account of
    // the dispute, and the precise coordinates of the disputed land. Firestore
    // cannot hide individual fields, so a rule broad enough to expose "just the
    // status" would expose all of that too — reads are officers only.
    //
    // There is deliberately no "reporter reads their own ticket" branch. Since
    // dispute intake moved off Firebase Phone Auth, a reporter has no auth
    // session at all and `reporterUid` is a synthetic "phone-"/"guest-" hash,
    // never an auth uid — such a branch could never match, and leaving it in
    // implied a self-service read path that does not exist.
    match /tickets/{ticketId} {
      // Registry browsing goes through `listTickets`, which projects away the
      // narrative; direct queries are still capped to one page.
      allow get: if canReadCases();
      allow list: if canReadCases() && isPagedQuery();

      // Every write goes through a trusted Cloud Function on the Admin SDK,
      // which bypasses these rules: `submitDispute` creates tickets, and
      // `updateTicketStatus` / `addTicketNote` re-check the officer allow-list
      // server-side before changing status or appending a note. So no client
      // needs write access here, and none is granted — that keeps the reporter's
      // identity, the dispute record and the audit trail unforgeable.
      allow write: if false;
    }

    // Uploaded case documents: Aadhaar/PAN copies and numbers, deeds and land
    // records, plus the screening results. Staff read them from the dossier;
    // only the upload, submit, review and purge functions (Admin SDK) write.
    // The files themselves live in Storage, which no client can reach.
    match /caseDocuments/{documentId} {
      allow get: if canReadCases();
      allow list: if canReadCases() && isPagedQuery();
      allow write: if false;
    }

    // Server-only collections, all reached exclusively by Cloud Functions on
    // the Admin SDK (which bypasses these rules). Denying everything here means
    // a client can never read an OTP hash, flip its own `verified`/`used` flag,
    // reset a rate-limit counter, or enumerate reporters' phone numbers.
    match /disputeOtps/{phone} {
      allow read, write: if false;
    }
    match /otpSendLimits/{ipHash} {
      allow read, write: if false;
    }
    match /reporterLimits/{uid} {
      allow read, write: if false;
    }
    match /reporters/{uid} {
      allow read, write: if false;
    }
    match /whatsappDeliveries/{eventId} {
      allow read, write: if false;
    }
    // Wave 2 server state: per-phone notification ceilings and per-address
    // status-lookup counters (hashed keys), open re-upload requests (case and
    // document ids), the escalation backfill cursor and the insights snapshot,
    // which staff read through getInsights, not directly.
    match /notificationLimits/{phoneHash} {
      allow read, write: if false;
    }
    match /statusLookupLimits/{addrHash} {
      allow read, write: if false;
    }
    match /documentRequests/{requestId} {
      allow read, write: if false;
    }
    match /escalationState/{stateId} {
      allow read, write: if false;
    }
    match /insightsCache/{snapshotId} {
      allow read, write: if false;
    }

    // Deny by default: any collection not matched above (disputeVerifications,
    // submissionReceipts, notificationPreferences, geocodeCache,
    // mapServiceLimits, documentUploadLimits, documentPurges, and anything
    // added later) stays server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
